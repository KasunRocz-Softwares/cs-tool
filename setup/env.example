# CS Tool — settings for deploy/docker-compose.yml
# Copy this file to .env next to docker-compose.yml, then fill in the REQUIRED values.

# ── Required ──────────────────────────────────────────────────────
# Database password.                       openssl rand -hex 16
POSTGRES_PASSWORD=
# Signs sign-in tokens.                    openssl rand -hex 32
JWT_SECRET=
# Encrypts stored GitHub tokens and secrets. openssl rand -hex 32
# Changing it later makes previously stored tokens unreadable.
TOKEN_ENC_KEY=
# The admin account. It is created on first start, and its password is reset to this
# value every time the API starts, so change it here (not only in the app).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Address ───────────────────────────────────────────────────────
# The address people (and agents) use to reach CS Tool.
PUBLIC_URL=http://localhost:8080
# Passkeys only work on this exact host name: localhost here, or your domain.
WEBAUTHN_RP_ID=localhost
# Ports on this machine. For a real domain with automatic HTTPS, set
# SITE_ADDRESS=monitor.example.com, HTTP_PORT=80, HTTPS_PORT=443,
# PUBLIC_URL=https://monitor.example.com and WEBAUTHN_RP_ID=monitor.example.com
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80

# ── Version ───────────────────────────────────────────────────────
# "latest", or pin a build such as "sha-abc1234" from the package page.
CS_TOOL_VERSION=latest

# ── Database (optional) ───────────────────────────────────────────
POSTGRES_DB=monitoring
POSTGRES_USER=monitor

# ── Email notifications (optional) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── AI assistant enrichment (optional; scores work without it) ───
# AI_PROVIDER=anthropic or openai
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ── GitHub webhooks for releases (optional) ──────────────────────
GITHUB_WEBHOOK_SECRET=
